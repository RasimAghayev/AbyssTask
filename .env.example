# Copy this file to var/.env and fill in the values for your machine.
# var/.env is ignored by git. Never commit a real credential.
#
# The same values can be supplied through the environment of the process that
# starts the compose stack. The environment wins over the file.

APP_NAME="photo-gallery-api"
APP_ENV=local
# The key is generated by "php artisan key:generate --show" and is not part
# of the repository. The application refuses to serve a request without one.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The database of the compose stack.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=abysstask
DB_USERNAME=abyss
DB_PASSWORD=abyss
# The root password of the database server. It is only used by the first
# start, when the server initialises its own account.
DB_ROOT_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The host port the application is reachable at.
APP_PORT=8080
